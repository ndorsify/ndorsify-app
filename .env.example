# Backend service base URLs (Vite reads REACT_APP_* at build time).
#
# Deployed: set REACT_APP_API_BASE alone. The seven services sit behind one
# origin and keep the paths they already serve, with /api in front
# (/api/auth/login, /api/campaigns, /api/discovery/creators — see the
# backend's vercel.json), so one base covers all of them. "/api" keeps the
# calls same-origin, so there is no CORS to configure. An absolute URL works
# too, and then the services need CORS_ORIGINS set to this app's domain.
#
#   REACT_APP_API_BASE=/api
#
# Local: leave it unset and the seven fall back to their own ports.
REACT_APP_USERS_URL=http://localhost:1000
REACT_APP_PROFILE_URL=http://localhost:6060
REACT_APP_MESSAGING_URL=http://localhost:3000
REACT_APP_DISCOVERY_URL=http://localhost:9000
REACT_APP_DYNAMIC_CONTENT_URL=http://localhost:5000
REACT_APP_CAMPAIGN_URL=http://localhost:2000
REACT_APP_COLLABORATION_URL=http://localhost:4000
